{
  "rewrites": [
    {
      "source": "/investswipe",
      "destination": "/investswipe/index.html"
    },
    {
      "source": "/investswipe/",
      "destination": "/investswipe/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev"
}
